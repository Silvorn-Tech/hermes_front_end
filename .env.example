EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth client IDs (public identifiers, not secrets — see docs/authentication.md).
# One "Web application" client (used for the web build and, in dev, also
# covers Expo Go's browser-based redirect) plus native clients for
# standalone/dev-client builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
